# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with: openssl rand -hex 32

POSTGRES_USER=monolith_user
POSTGRES_PASSWORD=
POSTGRES_DB=monolith_db

SECRET_KEY=

# First administrator, created on startup if missing (no default accounts exist any more).
# Min 8 characters. After first login, change it and clear these two lines.
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=
# Public self-registration (/register). Leave false unless you want anyone to create an account.
ALLOW_SIGNUP=false
# Bearer key for the /mcp endpoint; empty disables MCP. Generate: openssl rand -hex 32
MCP_API_KEY=
# Comma-separated browser origins allowed cross-origin; empty uses dev defaults. Same-origin proxy needs none.
CORS_ORIGINS=
# Allow webhooks to target private/internal hosts (self-hosted chat). Keep false otherwise.
WEBHOOK_ALLOW_PRIVATE=false

# Edge proxy host port (rootless Podman cannot bind <1024 by default)
HTTP_PORT=8080
APP_BASE_URL=http://localhost:8080

# --- Internal mail (docker-mailserver) ---
MAIL_DOMAIN=monolith.local
# Mailbox the app authenticates as (create it: see README "Mail setup")
SMTP_USER=noreply@monolith.local
SMTP_PASSWORD=
SMTP_STARTTLS=true
# false for the internal self-signed cert; true once you mount a real certificate
SMTP_VERIFY_TLS=false
EMAILS_FROM_EMAIL=noreply@monolith.local
