{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs-guide",
      "runtimeExecutable": "py",
      "runtimeArgs": ["-3.13", "-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "docs"],
      "port": 8765
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5174", "--strictPort"],
      "env": { "VITE_PROXY_TARGET": "http://localhost:8600" },
      "port": 5174
    }
  ]
}
