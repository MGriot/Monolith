<div style="font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:auto;color:#0f172a">
  <h2 style="margin-bottom:4px">Confirm your e-mail address</h2>
  <p>Hello {{ name }},</p>
  <p>Please confirm that this is your e-mail address for {{ app_name }}.</p>
  <p><a href="{{ link }}" style="display:inline-block;background:#0f172a;color:#fff;padding:10px 18px;border-radius:8px;text-decoration:none">Confirm e-mail address</a></p>
  <p style="font-size:13px;color:#475569">The link is valid for {{ hours }} hours. If the button does not work, copy this address into your browser:<br>{{ link }}</p>
  <p style="font-size:13px;color:#475569">If you did not create or change an account, ignore this e-mail.</p>
</div>
