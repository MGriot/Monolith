<div style="font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:auto;color:#0f172a">
  <h2 style="margin-bottom:4px">New assignment</h2>
  <p>Hello {{ name }},</p>
  <p>You have been assigned to the task <b>{{ task_title }}</b>{% if project_name %} in project <b>{{ project_name }}</b>{% endif %}.</p>
  <p><a href="{{ link }}" style="display:inline-block;background:#0f172a;color:#fff;padding:10px 18px;border-radius:8px;text-decoration:none">Open task</a></p>
  <p style="font-size:13px;color:#475569">You can turn these e-mails off in Settings &rsaquo; Notifications.</p>
</div>
