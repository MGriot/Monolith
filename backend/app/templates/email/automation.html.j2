<div style="font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:auto;color:#0f172a">
  <h2 style="margin-bottom:4px">{{ rule_name }}</h2>
  <p>Hello {{ name }},</p>
  <p>An automation ran on the task <b>{{ task_title }}</b>{% if project_name %} in project <b>{{ project_name }}</b>{% endif %}:</p>
  <p style="background:#f1f5f9;padding:12px 14px;border-radius:8px">{{ message }}</p>
  <p><a href="{{ link }}" style="display:inline-block;background:#0f172a;color:#fff;padding:10px 18px;border-radius:8px;text-decoration:none">Open task</a></p>
</div>
